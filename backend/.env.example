# Application Configuration
NODE_ENV=development
PORT=3005
API_VERSION=v1

# Database Configuration (PostgreSQL/Neon DB)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=leadflow_dev
DATABASE_USER=leadflow
DATABASE_PASSWORD=dev_password_123
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=100

# Redis Configuration (Caching & Dapr State Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=300

# Kafka/Redpanda Configuration (Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=leadflow-backend
KAFKA_CONSUMER_GROUP=leadflow-consumers
KAFKA_TOPIC_LEAD_EVENTS=lead-events

# Dapr Configuration
DAPR_HOST=localhost
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PUBSUB_NAME=kafka-pubsub
DAPR_STATE_STORE_NAME=redis-statestore
DAPR_SECRET_STORE_NAME=kubernetes-secrets

# Authentication (AWS Cognito / JWT)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id
JWT_AUDIENCE=your-client-id
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_REGION=us-east-1

# AI Configuration (OpenAI GPT API)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# AWS Configuration (optional for production)
AWS_REGION=us-east-1
AWS_SECRET_MANAGER_SECRET_NAME=leadflow-ai/production

# Feature Flags
ENABLE_CACHE=true
ENABLE_AI_QUALIFICATION=true
ENABLE_RATE_LIMITING=true

# Observability
ENABLE_XRAY_TRACING=false
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090

# Security
CORS_ORIGIN=http://localhost:3001
ENCRYPTION_KEY=your-encryption-key-for-pii-fields
